{
  "schema_version": 1,
  "name": "strict-cfd-v1",
  "status": "initial-project-gate",
  "description": "Initial BabelMesh acceptance thresholds; not a universal CFD quality standard.",
  "fatal_counts": {
    "negative_volume": 0,
    "zero_volume": 0,
    "degenerate_face": 0,
    "self_intersection": 0,
    "overlapping_cells": 0,
    "open_cells": 0,
    "non_manifold_cell_edges": 0,
    "unassigned_boundary_faces": 0,
    "multiply_assigned_boundary_faces": 0,
    "non_finite_coordinates": 0
  },
  "geometry": {
    "max_surface_deviation_relative_to_domain": 0.0001,
    "max_surface_deviation_relative_to_local_size": 0.05,
    "surface_distance_is_bidirectional": true,
    "sampling_resolution_must_be_reported": true
  },
  "face_geometry": {
    "max_non_orthogonality_degrees": 75.0,
    "p99_non_orthogonality_degrees": 60.0,
    "max_internal_skewness": 0.5,
    "p99_internal_skewness": 0.25,
    "min_owner_neighbour_projection": 0.0
  },
  "cell_geometry": {
    "max_core_transition_volume_ratio": 12.0,
    "regular_hex_min_scaled_jacobian": 0.1,
    "min_normalized_cell_volume": 1e-12
  },
  "boundary_layers": {
    "first_layer_weighted_p95_relative_error": 0.1,
    "first_layer_max_relative_error": 0.2,
    "max_observed_growth_ratio": 1.3,
    "smooth_wall_full_layer_area_coverage": 1.0,
    "complex_wall_first_layer_area_coverage": 0.99,
    "complex_wall_requested_layer_count_area_coverage": 0.95,
    "strict_regions_requested_layer_count_area_coverage": 1.0
  },
  "reports": {
    "require_cell_count_and_volume_weighted_distributions": true,
    "require_worst_entity_ids_and_locations": true,
    "require_separate_boundary_layer_and_core_statistics": true
  }
}
